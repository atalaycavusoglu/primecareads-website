# Copy to .env.local (and add the same keys in Vercel → Settings → Environment Variables).
# Leave a value empty to keep that feature off.

# Form delivery: free access key from https://web3forms.com (sent to the inbox you register there)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Google Ads tag ID, e.g. AW-123456789, and the lead conversion label
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
